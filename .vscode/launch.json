{
  // 调试配置。Flutter 工程位于 flutter_app/，所以通过 cwd 指定工作目录。
  // 首次使用前请确认已安装 VS Code 扩展 "Dart-Code.dart-code" 与 "Dart-Code.flutter"。
  "version": "0.2.0",
  "configurations": [
    {
      // 默认配置：使用 VS Code 状态栏中当前选中的设备（macOS / iOS 模拟器 / Android 真机等）。
      // templateFor 让编辑器里的 Run/Debug CodeLens 也复用这份配置。
      "name": "MusicFly (当前选中设备)",
      "type": "dart",
      "request": "launch",
      "cwd": "flutter_app",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "templateFor": ""
    },
    {
      "name": "MusicFly (macOS)",
      "type": "dart",
      "request": "launch",
      "cwd": "flutter_app",
      "program": "lib/main.dart",
      "deviceId": "macos",
      "flutterMode": "debug"
    },
    {
      // Windows 本机调试：锁定 windows 桌面设备，不依赖状态栏当前选中的设备。
      // debug 模式才有热重载 / 热重启；profile、release 模式没有。
      // 若「Flutter: Select Device」里看不到 Windows，先执行
      //   flutter config --enable-windows-desktop
      // 本机 SDK 路径由 .vscode/settings.json 的 dart.flutterSdkPath 指定。
      "name": "MusicFly (Windows)",
      "type": "dart",
      "request": "launch",
      "cwd": "flutter_app",
      "program": "lib/main.dart",
      "deviceId": "windows",
      "flutterMode": "debug",
      // VM service 走 127.0.0.1，代理会拦坏它的 WebSocket 升级请求
      // （flutter test 在这里踩过 "Invalid WebSocket upgrade request"）。
      // 拼接原有的 NO_PROXY，只补本地例外，不覆盖你已有的内网白名单。
      "env": {
        "NO_PROXY": "127.0.0.1,localhost,${env:NO_PROXY}",
        "no_proxy": "127.0.0.1,localhost,${env:no_proxy}"
      }
    },
    {
      // 运行 flutter_app/test 下的全部测试，可在测试代码中打断点。
      "name": "MusicFly (全部测试)",
      "type": "dart",
      "request": "launch",
      "cwd": "flutter_app",
      "program": "test",
      "flutterMode": "debug"
    },
    {
      // 真实服务端集成测试。默认地址为文档中的本地服务端示例，按需修改。
      "name": "MusicFly (真实服务端集成测试)",
      "type": "dart",
      "request": "launch",
      "cwd": "flutter_app",
      "program": "test/live_backend_test.dart",
      "env": {
        "MUSICFLY_TEST_SERVER": "http://127.0.0.1:14533",
        "MUSICFLY_TEST_USER": "admin",
        "MUSICFLY_TEST_PASSWORD": "admin"
      }
    }
  ]
}
