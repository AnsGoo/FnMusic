<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ draws a system splash screen before the activity starts;
     keep it dark with the vinyl logo so it blends with the Flutter splash. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_logo</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_bg</item>
    </style>
</resources>
